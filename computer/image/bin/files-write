#!/usr/bin/env python3
import base64
import os
import sys

path = sys.argv[1]
payload = sys.argv[2] if len(sys.argv) > 2 else ""
if not path.startswith("/tenant/"):
    sys.exit(2)
os.makedirs(os.path.dirname(path), exist_ok=True)
data = base64.b64decode(payload)
with open(path, "wb") as handle:
    handle.write(data)
os.chmod(path, 0o660)
print('{"ok":true}')
