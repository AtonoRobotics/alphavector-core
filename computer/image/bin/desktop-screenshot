#!/usr/bin/env python3
import base64
import json
import os
import subprocess
import sys
import tempfile

display = sys.argv[1] if len(sys.argv) > 1 else "10"
env = os.environ.copy()
env["DISPLAY"] = f":{display}"
env["XAUTHORITY"] = f"/tmp/av-desktops/Xauthority-{display}"

with tempfile.NamedTemporaryFile(suffix=".png", delete=False) as handle:
    path = handle.name

try:
    subprocess.run(["scrot", "-o", path], check=True, env=env, capture_output=True)
    with open(path, "rb") as shot:
        payload = base64.b64encode(shot.read()).decode("ascii")
    print(json.dumps({"png_base64": payload, "display": int(display), "mime": "image/png"}))
finally:
    try:
        os.unlink(path)
    except OSError:
        pass
