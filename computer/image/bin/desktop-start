#!/usr/bin/env bash
set -euo pipefail

agent_id="${1:?agent id required}"
display="${2:?display required}"
width="${3:-1280}"
height="${4:-720}"

mkdir -p /tmp/av-desktops "/tenant/state/desktops/${agent_id}"
auth="/tmp/av-desktops/Xauthority-${display}"
log="/tmp/av-desktops/x-${display}.log"
touch "$auth"
chmod 600 "$auth"

if [[ -S "/tmp/.X11-unix/X${display}" ]]; then
  echo "{\"display\":${display},\"agentId\":\"${agent_id}\",\"status\":\"already-running\"}"
  exit 0
fi

# Distinct solid color per display. Fluxbox is told not to overwrite it.
r=$((16 + (display * 37) % 200))
g=$((32 + (display * 53) % 180))
b=$((64 + (display * 19) % 160))
color=$(printf '#%02x%02x%02x' "$r" "$g" "$b")

Xvfb ":${display}" -screen 0 "${width}x${height}x24" -ac -nolisten tcp >"$log" 2>&1 &
for _ in $(seq 1 50); do
  if [[ -S "/tmp/.X11-unix/X${display}" ]]; then
    break
  fi
  sleep 0.1
done

export DISPLAY=":${display}"
export XAUTHORITY="$auth"
xsetroot -solid "$color"

fb_dir="/tmp/av-desktops/fb-${display}"
mkdir -p "$fb_dir"
cat > "${fb_dir}/init" <<EOF
session.screen0.rootCommand: xsetroot -solid ${color}
session.screen0.toolbar.visible: false
EOF
fluxbox -display ":${display}" -rc "${fb_dir}/init" >/tmp/av-desktops/flux-${display}.log 2>&1 &
sleep 0.2
xsetroot -solid "$color"
DISPLAY=":${display}" XAUTHORITY="$auth" x11vnc -display ":${display}" -rfbport $((5900 + display)) -forever -shared -nopw -localhost >/tmp/av-desktops/vnc-${display}.log 2>&1 &

printf '%s\n' "$display" > "/tenant/state/desktops/${agent_id}/display"
printf '%s\n' "$color" > "/tenant/state/desktops/${agent_id}/color"
echo "{\"display\":${display},\"agentId\":\"${agent_id}\",\"status\":\"started\",\"color\":\"${color}\"}"
