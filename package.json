{
  "name": "alphavector-core",
  "version": "0.1.0",
  "private": true,
  "description": "AV Dev — domain-agnostic autonomous agent operating system. Pack-agnostic host, not Mission Control, not the Real Estate pack.",
  "displayName": "AV Dev",
  "bundleId": "llc.alphavector.dev",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./product": "./dist/product.js"
  },
  "bin": {
    "av-dev": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "computer:build": "docker build -t llc.alphavector.dev/computer:0.1.0 -f computer/image/Dockerfile computer/image",
    "fixtures:sign": "tsx scripts/sign-pack.ts",
    "migrate": "tsx src/data/migrate.ts"
  },
  "dependencies": {
    "fastify": "^5.4.0",
    "@fastify/static": "^8.2.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76",
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
