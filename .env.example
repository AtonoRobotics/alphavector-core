# No secrets belong in the repository.
# AV_DATA_DIR=.av-data
# AV_COMPUTER_DIR=.av-computers
# AV_TENANT=t1
# AV_FIELD_TOKEN=   # present a token Architect issued; field-serve does not mint
# Product boot trust anchors (DEC-019). The process does not generate these keys.
# AV_TRUST_ANCHORS_FILE=   # JSON { architectPublicKeyPem, counselEvalPublicKeyPem }
# AV_ARCHITECT_PUBLIC_KEY=
# AV_COUNSEL_EVAL_PUBLIC_KEY=
# AV_ARCHITECT_PUBLIC_KEY_FILE=
# AV_COUNSEL_EVAL_PUBLIC_KEY_FILE=
# AV_PACK_PATH=   # signed pack JSON; unsigned bundled fixture fails closed
# DATABASE_URL=postgres://localhost:5432/alphavector
